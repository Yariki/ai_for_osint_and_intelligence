DATABASE_URL=sqlite:///./data/rss.db
REDIS_URL=redis://redis:6379/0
WORKER_CONCURRENCY=1
DEFAULT_PERIOD_MINUTES=60
SCHEDULER_INTERVAL_SECONDS=30
REQUEST_DELAY_SECONDS=3
REQUEST_JITTER_SECONDS=1
REQUEST_TIMEOUT_SECONDS=20
MAX_RESPONSE_BYTES=5242880
MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=30
ROBOTS_CACHE_SECONDS=86400
JOB_LEASE_SECONDS=300
DISPATCH_LEASE_SECONDS=120
USER_AGENT=RespectfulRSSReader/1.0
# Optional fixed outbound HTTP(S) proxy. Credentials are never sent to the UI.
PROXY_URL=
WEB_PORT=8080

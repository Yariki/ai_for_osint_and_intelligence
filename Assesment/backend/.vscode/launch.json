{
    "version": "0.2.0",
    "configurations": [
        {
            // On the host, with the backend venv. No NET_RAW, so the scanner
            // runs in connect mode: no SYN, no ICMP.
            "name": "scan_one: connect",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "program": "${workspaceFolder}/scripts/scan_one.py",
            "args": ["${input:address}", "--ports", "${input:ports}"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "NDM_VANTAGE_POINT": "dev",
                "NDM_ALLOW_NON_PUBLIC_TARGETS": "true"
            }
        },
        {
            // SYN scan on the host. Requires NET_RAW on the Python binary:
            //   sudo setcap cap_net_raw+ep .venv/bin/python3.x
            // Without the capability the scanner falls back to connect mode.
            "name": "scan_one: SYN (local)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "program": "${workspaceFolder}/scripts/scan_one.py",
            "args": ["${input:address}", "--ports", "${input:ports}", "--syn"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "NDM_VANTAGE_POINT": "dev",
                "NDM_ALLOW_NON_PUBLIC_TARGETS": "true"
            }
        },
        {
            // Host discovery: ICMP echo + TCP probes to the given ports.
            // ICMP needs NET_RAW (see "SYN (local)" above); without it
            // discovery uses only TCP probes.
            "name": "scan_one: discovery (local)",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "program": "${workspaceFolder}/scripts/scan_one.py",
            "args": ["${input:address}", "--ports", "${input:ports}", "--discovery"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "NDM_VANTAGE_POINT": "dev",
                "NDM_ALLOW_NON_PUBLIC_TARGETS": "true"
            }
        },
        {
            // In the dev scanner container (host network, NET_RAW): SYN and ICMP
            // work. The task starts it; it waits for this debugger on port 5678.
            "name": "scan_one: SYN (container, attach)",
            "type": "debugpy",
            "request": "attach",
            "preLaunchTask": "scan_one: start in scanner container",
            "connect": { "host": "127.0.0.1", "port": 5678 },
            "pathMappings": [
                { "localRoot": "${workspaceFolder}/src", "remoteRoot": "/src" },
                { "localRoot": "${workspaceFolder}/scripts", "remoteRoot": "/scripts" }
            ],
            "justMyCode": true
        },
        // The dev stack under debugpy (deploy/compose.debug.yaml). Start it with
        // "dev stack: debug all", which runs the task "dev stack (debug): up"
        // first; the three below attach to a stack that is already up.
        // Hot reload: saving a file under src restarts the service process in
        // its container and the debugger attaches to the new process by
        // itself (subProcess). A breakpoint in a loop that was already running
        // when you attached is hit only after the next reload.
        {
            "name": "api (dev container, attach)",
            "type": "debugpy",
            "request": "attach",
            "connect": { "host": "127.0.0.1", "port": 5681 },
            "pathMappings": [
                { "localRoot": "${workspaceFolder}/src", "remoteRoot": "/src" },
                { "localRoot": "${workspaceFolder}/scripts", "remoteRoot": "/scripts" }
            ],
            "subProcess": true,
            "justMyCode": true
        },
        {
            "name": "orchestrator (dev container, attach)",
            "type": "debugpy",
            "request": "attach",
            "connect": { "host": "127.0.0.1", "port": 5682 },
            "pathMappings": [
                { "localRoot": "${workspaceFolder}/src", "remoteRoot": "/src" },
                { "localRoot": "${workspaceFolder}/scripts", "remoteRoot": "/scripts" }
            ],
            "subProcess": true,
            "justMyCode": true
        },
        {
            // On the host network, with NET_RAW: SYN and ICMP work.
            "name": "scanner (dev container, attach)",
            "type": "debugpy",
            "request": "attach",
            "connect": { "host": "127.0.0.1", "port": 5683 },
            "pathMappings": [
                { "localRoot": "${workspaceFolder}/src", "remoteRoot": "/src" },
                { "localRoot": "${workspaceFolder}/scripts", "remoteRoot": "/scripts" }
            ],
            "subProcess": true,
            "justMyCode": true
        }
    ],
    "compounds": [
        {
            // Starts (or updates) the debug dev stack, then attaches to all three.
            // Stopping the session detaches; the stack keeps running
            // (task "dev stack: down" stops it).
            "name": "dev stack: debug all",
            "configurations": [
                "api (dev container, attach)",
                "orchestrator (dev container, attach)",
                "scanner (dev container, attach)"
            ],
            "preLaunchTask": "dev stack (debug): up",
            "stopAll": true
        }
    ],
    "inputs": [
        {
            "id": "address",
            "type": "promptString",
            "description": "Address to scan",
            "default": "10.77.3.10"
        },
        {
            "id": "ports",
            "type": "promptString",
            "description": "Ports: a list (22,80,8000-8100) or top-100, top-1000, full",
            "default": "22,80,443"
        }
    ]
}

# ndm-backend: the image of the api, orchestrator and migrate services.
# Build context: the Assesment/ directory.
#
# No secret is used at build time: the only build arguments are the release
# version and commit, and the environment file is excluded from the context
# (.dockerignore).

FROM python:3.14.4-slim-bookworm AS build

COPY --from=ghcr.io/astral-sh/uv:0.13.8 /uv /bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# Dependencies first, exactly as locked, so this layer is rebuilt only when the lockfile changes.
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --locked --no-dev --extra backend --no-install-project

# Then the package itself, installed into the environment (not editable).
COPY backend/src ./src
RUN uv sync --locked --no-dev --extra backend --no-editable


FROM python:3.14.4-slim-bookworm

# The release this image belongs to. Not a secret: the version and the commit.
ARG NDM_VERSION=dev
ARG NDM_REVISION=unknown
LABEL org.opencontainers.image.title="ndm-backend" \
      org.opencontainers.image.version="${NDM_VERSION}" \
      org.opencontainers.image.revision="${NDM_REVISION}" \
      org.opencontainers.image.description="Network Discovery Map"

RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin ndm \
    # The reference-data volume is mounted here. An empty directory owned by
    # the service's user makes a new volume writable for it. No dataset is in
    # the image (NFR-LIC-1).
    && mkdir -p /var/lib/ndm/reference \
    && chown 10001 /var/lib/ndm/reference

WORKDIR /app
COPY --from=build /app/.venv /app/.venv
COPY backend/alembic.ini ./

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER 10001
EXPOSE 8000

# The api service. The migrate service overrides this with "alembic upgrade head".
CMD ["uvicorn", "--factory", "ndm.api.app:production_app", "--host", "0.0.0.0", "--port", "8000"]

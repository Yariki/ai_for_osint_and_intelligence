# Settings of the product stack when it scans the Compose lab.
# Use it on top of the installation's own .env (from deploy/):
#
#   docker compose --env-file .env --env-file lab/lab.env up -d --build
#
# NEVER use this file for a real installation: it switches the public-address
# rule off.

# The lab is private address space (10.77.0.0/16). The switch reaches the api,
# the orchestrator and the scanner, and it takes effect only because all three
# have it. Each start with the switch on is written to the audit log.
NDM_ALLOW_NON_PUBLIC_TARGETS=true

# What probes are sent from, as the lab sees it: the host's address on the
# lab's transit network.
NDM_EGRESS_ADDRESS=10.77.0.1
NDM_VANTAGE_POINT=lab

# Reverse DNS goes to the lab resolver, which knows the lab hosts and forwards
# nothing (deploy/lab/resolver).
NDM_PTR_RESOLVER=10.77.0.1:1053

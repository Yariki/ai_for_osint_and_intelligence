# Network Discovery Map: environment of the Compose stack.
#
# Copy this file to ".env" in this directory and replace every placeholder.
# The values below are placeholders only; the stack refuses to start while a
# password is missing. Never commit the ".env" file.

# --- Secrets -----------------------------------------------------------------
# Passwords of the two database roles. They are put into connection URLs, so
# use letters, digits and the characters - _ . ~ only.
# Generate each one with:  openssl rand -hex 24
NDM_DB_OWNER_PASSWORD=replace-with-a-generated-password
NDM_DB_APP_PASSWORD=replace-with-another-generated-password
# Password of the message broker, used by the api, the orchestrator and the scanner.
NDM_BROKER_PASSWORD=replace-with-a-third-generated-password

# --- Address -----------------------------------------------------------------
# The host name or IP address the analyst types into the browser. The proxy
# issues its certificate for this name.
NDM_SITE_ADDRESS=localhost

# --- Optional settings (the defaults are shown) -------------------------------
# Names of the two database roles. They take effect only when the database
# volume is first initialized.
# NDM_DB_OWNER=ndm_owner
# NDM_DB_APP_ROLE=ndm_app

# Seconds of inactivity after which a session ends.
# NDM_SESSION_IDLE_TIMEOUT_SECONDS=1800

# Largest number of addresses one project scope may hold.
# NDM_PROJECT_SCOPE_CEILING=65536

# Addresses that are rejected in every project scope: comma-separated single
# addresses, CIDR blocks or start-end ranges. The API does not start if an
# entry is not valid.
# NDM_NEVER_SCAN=

# NDM_LOG_LEVEL=INFO

# --- Scanning: operator ceilings (not editable in the application) -------------
# Packets per second across all running scans.
# NDM_GLOBAL_RATE_PPS=5000

# Scans that run at the same time; further scans wait in the queue.
# NDM_MAX_CONCURRENT_SCANS=3

# Traceroutes that run at the same time, at most 50; further ones wait. A
# running scan never delays a traceroute: they have a queue of their own.
# NDM_MAX_CONCURRENT_TRACEROUTES=5

# Shortest time between two runs of a schedule, in seconds, at least 60. A
# schedule whose interval or cron expression runs more often is rejected.
# NDM_MIN_SCHEDULE_INTERVAL_SECONDS=3600

# --- Scanner -------------------------------------------------------------------
# Name of the place scans are made from. Lower-case letters, digits, - and _.
# NDM_VANTAGE_POINT=default

# The public address probes leave from, recorded with each scan. Leave it
# unset to let the scanner use the address the host routes from.
# NDM_EGRESS_ADDRESS=

# Source ports of SYN probes, as low-high. The range must lie outside
# net.ipv4.ip_local_port_range, or the scanner switches SYN scanning off.
# NDM_SOURCE_PORT_RANGE=61000-61999

# The scanner-netinit container installs two firewall rules on the host for
# that port range. Set this to true to apply them by hand instead.
# NDM_NETINIT_SKIP=false

# iptables back end of the host: "iptables" (nftables) or "iptables-legacy".
# NDM_IPTABLES=iptables

# --- Enrichment: reference datasets ---------------------------------------------
# All of this is optional. Without a dataset a scan still completes, and the
# fields the dataset would fill are shown as unavailable.

# Your own MaxMind account ID and licence key, for the GeoLite2 City and ASN
# databases: location, ASN and AS holder. The key is a secret. The databases
# are downloaded by the orchestrator and are not part of this application.
# NDM_MAXMIND_ACCOUNT_ID=
# NDM_MAXMIND_LICENSE_KEY=

# Hours between checks for a new GeoLite2 database and between downloads of
# the registries' data.
# NDM_GEOLITE_UPDATE_INTERVAL_HOURS=24
# NDM_RIR_UPDATE_INTERVAL_HOURS=168

# Registries whose registration records are downloaded, for network names and
# organizations: any of ripe, apnic, afrinic, comma-separated. Empty by
# default. List a registry only if your use meets its terms; they are in
# docs/datasets/registry-sources.md. The delegation statistics of all five
# registries are always loaded.
# NDM_RIR_OBJECT_REGISTRIES=

# Directory on this host with bulk files you obtained from ARIN (arin_db.xml)
# and LACNIC. It is mounted read-only into the orchestrator.
# NDM_RIR_FILES_DIR=./registry-files

# Reverse DNS. Each discovered host's address is sent to a resolver. Set the
# resolver as address or address:port; unset, the host's resolver is used.
# Set NDM_PTR_ENABLED=false to send no query at all.
# NDM_PTR_ENABLED=true
# NDM_PTR_RESOLVER=

# --- Classification ---------------------------------------------------------------
# Below this confidence, from 0 to 1, a host's device type is "unknown". A
# change applies to scans classified afterwards; stored results stay as they are.
# NDM_CLASSIFICATION_THRESHOLD=0.5

# --- Map ------------------------------------------------------------------------
# The raster tile source of the map, with the placeholders {z}, {x} and {y},
# and the attribution its provider requires. There is no default: choose a
# provider whose usage policy permits your use. Without a tile source the map
# shows a notice and contacts no tile server.
# NDM_TILE_URL_TEMPLATE=https://tiles.example.org/{z}/{x}/{y}.png
# NDM_TILE_ATTRIBUTION=© Example Maps

# --- Test switch ------------------------------------------------------------------
# It permits non-public addresses in scopes and as scan targets, and exists
# for the lab only. It is passed to the api, the orchestrator and the scanner,
# and takes effect only because all three have it. Leave it unset in every
# real installation. Its use is written to the log and to the audit log at
# start-up.
# NDM_ALLOW_NON_PUBLIC_TARGETS=false

# --- Release ----------------------------------------------------------------------
# The release of the project's images (deploy/release/VERSIONS.md). Leave unset
# to run the release this checkout belongs to. NDM_REVISION is the commit the
# images are labelled with when Compose builds them; build-images.sh sets it.
# NDM_VERSION=1.0.0-rc.1
# NDM_REVISION=unknown
